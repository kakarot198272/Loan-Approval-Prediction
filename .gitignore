# ======================
# Data files (DO NOT COMMIT)
# ======================
data/*.csv

# ======================
# Outputs
# Ignore all outputs by default
# ======================
outputs/*

# Allow figures directory and ROC image
!outputs/figures/
!outputs/figures/roc_curves.png

# ======================
# Virtual environment
# ======================
venv/

# ======================
# Python cache
# ======================
__pycache__/
*.pyc



